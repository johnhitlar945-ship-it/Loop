# Supabase project settings. Keep the service-role key server-side only.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# OpenAI API key used only by the server to create article drafts.
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-4.1-mini

# Set long random values before deploying.
ADMIN_SECRET=REPLACE_WITH_A_LONG_RANDOM_ADMIN_PASSWORD
CRON_SECRET=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_SECRET
